{
  "name": "vex-brain-sim",
  "version": "0.1.0",
  "description": "VEX V5 Brain screen simulator - paste VEXcode C++ or Python and see it drawn on a virtual Brain",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/rename-electron.mjs",
    "desktop": "npm run build && npm run build:electron && electron .",
    "dist": "npm run build && npm run build:electron && electron-builder"
  },
  "build": {
    "appId": "com.vexbrainsim.app",
    "productName": "VEX Brain Simulator",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  }
}
